{
  "name": "dsh-ocean-background",
  "version": "0.3.1",
  "type": "module",
  "description": "A daytime sea behind the whole Harness window: a pirate ship for the main agent, a rowboat for every subagent, canvas that follows activity, and waves driven by token throughput.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/butterfly301/dsh-ocean-background.git"
  },
  "homepage": "https://github.com/butterfly301/dsh-ocean-background#readme",
  "bugs": {
    "url": "https://github.com/butterfly301/dsh-ocean-background/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ocean",
    "background",
    "threejs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0",
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test \"test/*.test.js\"",
    "sync": "node scripts/sync-profile.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "host",
    "runtime",
    "locale",
    "icon.svg",
    "preview.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
