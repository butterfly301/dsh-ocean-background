{
  "name": "dsh-ocean-background",
  "version": "0.1.6",
  "type": "module",
  "description": "A daytime sea behind the whole Harness window: a pirate ship for the main agent, a rowboat for every subagent, canvas that follows activity, and waves driven by token throughput.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/butterfly301/dsh-ocean-background.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "mileage.js",
    "host",
    "runtime",
    "locale/*.json",
    "icon.svg",
    "preview.png"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
